# Environment Variables Template
# Copy this file to .env.local for local development (do not commit .env.local)

# --- Supabase Configuration ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# --- OMR Microservice Engine ---
OMR_SERVICE_URL=http://localhost:8000
OMR_SERVICE_API_KEY=local-omr-secret-key-32chars-min

# --- Resend Email Provider ---
RESEND_API_KEY=re_123456789_abcdefg
RESEND_FROM_EMAIL=notifications@your-institute-domain.com

# --- Monitoring & Observability ---
SENTRY_DSN=https://your-sentry-dsn@sentry.io/123456
ENVIRONMENT=development
LOG_LEVEL=debug
